{{!
    @template mod_externalassignment/grading_navigation_user_selector

    The template HTML for the user selector in the top right corner.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action, data-assignmentid, data-groupid, data-region

    Context variables required for this template:
    * currentuserid, assignmentid, groupid, filters.key, filters.name

    This template uses ajax functionality, so it cannot be shown in the template library.

    Example context (json):
    { }
}}
<div class="mb-2">
    <label for="status-filter" class="visually-hidden">{{#str}} statusfilter, mod_externalassignment {{/str}}</label>
    <select id="status-filter" class="form-select" aria-label="{{#str}} statusfilter, mod_externalassignment {{/str}}">
        <option value="">{{#str}} allstatuses, mod_externalassignment {{/str}}</option>
        <option value="open">{{#str}} open, mod_externalassignment {{/str}}</option>
        <option value="done">{{#str}} done, mod_externalassignment {{/str}}</option>
    </select>
</div>
<a id="previous-user" href="#previous" data-action="previous-user" aria-label="{{#str}} previoususer, mod_externalassignment {{/str}}" title="{{#str}} previoususer, mod_externalassignment {{/str}}">◄</a>
<span data-region="input-field">
    <label for="change-user-select" class="visually-hidden">{{#str}} changeuser, mod_externalassignment {{/str}}</label>
    <select id="change-user-select" data-action="change-user" data-currentuserid="{{currentuserid}}" data-assignmentid="{{assignmentid}}"
            data-groupid="{{groupid}}"></select>
</span>
<a id="next-user" href="#next" data-action="next-user" aria-label="{{#str}} nextuser, mod_externalassignment {{/str}}" title="{{#str}} nextuser, mod_externalassignment {{/str}}">►</a>
